<UserControl x:Class="HW1.Views.ProcessesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:HW1.Views"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="600">
    <Grid Background="Transparent">
        
        <Grid.RowDefinitions>
            
            <RowDefinition Height="0.15*"/>
            <RowDefinition/>
            
        </Grid.RowDefinitions>
        
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="0">
            
            <Button  Content="Start"  FontSize="10"  Height="34" Background="Transparent" Foreground="White" Command="{Binding StartCommand}" >
                <Button.Effect>
                    <DropShadowEffect/>
                </Button.Effect>
            </Button>

            <Button  Content="Block"  FontSize="10"  Height="34" Background="Transparent" Foreground="White" Command="{Binding BlockCommand}" >
                <Button.Effect>
                    <DropShadowEffect/>
                </Button.Effect>
            </Button>
            
            <Button  Content="Kill"  FontSize="10"  Height="34" Background="Transparent" Foreground="White" Command="{Binding KillCommand}" >
                <Button.Effect>
                    <DropShadowEffect/>
                </Button.Effect>
            </Button>
            
        </StackPanel>
        
        <StackPanel Grid.Row="0" HorizontalAlignment="Left" Orientation="Horizontal">
            
            <TextBox Width="240" Height="30" Margin="0,0,0,0" Background="White" Text="{Binding SearchedProcess}"></TextBox>
            
            <Button  Background="Transparent" Content="Search" Height="30" Foreground="White" Command="{Binding SearchCommand}">
                <Button.Effect>
                    <DropShadowEffect/>
                </Button.Effect>
            </Button>
            
            <Button  Background="Transparent" Content="Reset" Height="30" Foreground="White" Command="{Binding ResetCommand}">
                <Button.Effect>
                    <DropShadowEffect/>
                </Button.Effect>
            </Button>

            
        </StackPanel>
        
        
        
        <ListView Grid.Row="1" ItemsSource="{Binding Processes}" SelectedItem="{Binding SelectedProcess}">
            
            <ListView.ItemTemplate>
                
                <DataTemplate>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="2">
                        
                        <TextBlock Text="{Binding Id, StringFormat='Id: {0}'}" Foreground="White" Margin="0,0,10,0"></TextBlock>
                        <TextBlock Text="{Binding ProcessName, StringFormat='Name: {0}'}" Foreground="White" Margin="0,0,10,0"></TextBlock>
                        <TextBlock Text="{Binding BasePriority, StringFormat='Priority: {0}'}" Foreground="White" Margin="0,0,10,0"></TextBlock>
                        <TextBlock Text="{Binding Threads.Count, StringFormat='Threads: {0}'}" Foreground="White" Margin="0,0,10,0"></TextBlock>
                    </StackPanel>
                    
                    
                </DataTemplate>
                
            </ListView.ItemTemplate>
            
        </ListView>
        
    </Grid>
</UserControl>
